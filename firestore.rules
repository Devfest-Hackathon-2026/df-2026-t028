rules_version = '2';

// 方針：
// - スポット・投稿の読み書きはすべて Cloud Run の API（Admin SDK、ルールの対象外）が行う。
//   spots には埋め込み・知名度など内部用の値があり、Firestore のルールではフィールド単位で隠せないため、
//   クライアントからの直接読み取りも禁止する。
// - クライアントが直接扱えるのは、自分の「いいね」だけ。押した瞬間に反映するため。
service cloud.firestore {
  match /databases/{database}/documents {

    // いいね：users/{uid}/likes/{spotId} = { created_at: <サーバー時刻> }
    match /users/{uid}/likes/{spotId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
                    && spotId.matches('^[a-z0-9_]{1,64}$')
                    && request.resource.data.keys().hasOnly(['created_at'])
                    && request.resource.data.created_at == request.time;
      allow update: if false;
    }

    // それ以外（spots・posts・users の他のパスなど）はすべて拒否
    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
  }
}
